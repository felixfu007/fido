<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.3.4</version>
        <relativePath/>
    </parent>

    <groupId>com.fido.server</groupId>
    <artifactId>fido-server</artifactId>
    <version>1.0.0</version>
    <name>fido-server</name>
    <description>
        FIDO/FIDO2 驗證伺服器 — 情境 A（標準 WebAuthn，同裝置）。
        骨架版本：persistence 層以 in-memory repository 頂住，待 devops-engineer
        建置 SQL Server 後可替換為 JPA/JDBC 實作（介面於 com.fido.server.repository）。
    </description>

    <properties>
        <java.version>21</java.version>
        <jjwt.version>0.12.6</jjwt.version>
        <bouncycastle.version>1.81</bouncycastle.version>
    </properties>

    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>

        <!--
            內部可觀測性（CLAUDE.md「內部可觀測性 + 唯讀 list-tenants」交辦）：Prometheus 格式的
            /actuator/prometheus 端點所需的 registry 實作。只加依賴、不直接呼叫其 API——
            四個自訂業務指標一律經由 spring-boot-starter-actuator 自動組態提供的
            io.micrometer.core.instrument.MeterRegistry 記錄，該 registry 會自動同時發布到本
            registry。此端點與 health/info/metrics 一併只掛在獨立管理端口
            （management.server.port，見 application.yml），不會出現在對外的 8443。
        -->
        <dependency>
            <groupId>io.micrometer</groupId>
            <artifactId>micrometer-registry-prometheus</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!--
            Persistence 層（見 com.fido.server.repository.jpa.*）。fido.persistence.mode=jpa
            （預設，對齊 CLAUDE.md「獨立 SQL Server 實例」）時才會實際建立 DataSource / EntityManager
            （見 com.fido.server.config.JpaInfrastructureConfig）；mode=memory 時完全不會用到，
            但 starter 本身必須在 main scope 才能讓 Spring Data JPA repository 介面編譯/掃描得到。
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>

        <!--
            正式環境資料庫驅動（獨立 SQL Server 實例，見 CLAUDE.md）。main scope：待
            devops-engineer 提供可連線的 SQL Server 環境後，僅需調整
            spring.datasource.url/username/password 等連線設定即可接上，不需改程式碼／改 scope。
        -->
        <dependency>
            <groupId>com.microsoft.sqlserver</groupId>
            <artifactId>mssql-jdbc</artifactId>
        </dependency>

        <!-- CBOR 解碼（WebAuthn attestationObject 為 CBOR 格式）；用於解析 fmt/authData/attStmt 頂層結構。 -->
        <dependency>
            <groupId>com.fasterxml.jackson.dataformat</groupId>
            <artifactId>jackson-dataformat-cbor</artifactId>
        </dependency>

        <!--
            Android Key Attestation extension（OID 1.3.6.1.4.1.11129.2.1.17）是一段自訂 ASN.1
            DER 結構（KeyDescription SEQUENCE），JDK 內建 X509Certificate 只能取出其未解碼的
            extnValue 原始 bytes，無法解析內容。bcprov 提供 org.bouncycastle.asn1.* 這組通用
            ASN.1 讀取原語（ASN1Sequence/ASN1Enumerated/ASN1OctetString...），足以完成本專案
            唯一需要的欄位讀取（attestationSecurityLevel / keymasterSecurityLevel /
            attestationChallenge），不需要額外的 CMS/PKIX 協定支援，故正式執行路徑只依賴
            bcprov-jdk18on。X.509 憑證鏈本身的簽章驗證與效期檢查改用 JDK 原生
            java.security.cert API（Certificate#verify / #checkValidity），不假手 BC。
        -->
        <dependency>
            <groupId>org.bouncycastle</groupId>
            <artifactId>bcprov-jdk18on</artifactId>
            <version>${bouncycastle.version}</version>
        </dependency>

        <!-- Session JWT（ES256）簽發與驗證 -->
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-api</artifactId>
            <version>${jjwt.version}</version>
        </dependency>
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-impl</artifactId>
            <version>${jjwt.version}</version>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-jackson</artifactId>
            <version>${jjwt.version}</version>
            <scope>runtime</scope>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>

        <!--
            僅測試需要：組出「合法」的 Android Key Attestation 憑證鏈測試 fixture（含自訂
            attestationSecurityLevel/attestationChallenge extension、簽章鏈）。bcpkix 的
            X509v3CertificateBuilder / ContentSigner 是撰寫這類自簽測試憑證最省力的方式；
            正式執行路徑（main scope）不使用，故限定 test scope，不會被打包進部署產物。
        -->
        <dependency>
            <groupId>org.bouncycastle</groupId>
            <artifactId>bcpkix-jdk18on</artifactId>
            <version>${bouncycastle.version}</version>
            <scope>test</scope>
        </dependency>

        <!--
            H2（MSSQL 相容模式，見 src/test/resources/application-h2.yml 的
            jdbc:h2:...;MODE=MSSQL 連線字串）：僅供本機開發/測試時模擬 SQL Server，把
            JPA/persistence 層真的接起來、跑過一次真實 SQL 執行路徑。test scope：
            不會被 spring-boot-maven-plugin repackage 進部署產物，也不會出現在
            `mvn spring-boot:run` 的執行期 classpath，避免正式部署誤用 H2。
        -->
        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <executions>
                    <!--
                        產生 META-INF/build-info.properties，供 /actuator/info（管理端口）回傳
                        build.artifact / build.name / build.version / build.time（CLAUDE.md
                        「管理後台 / 客戶 Portal 評估拍板結果」決策 2）。
                    -->
                    <execution>
                        <goals>
                            <goal>build-info</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
