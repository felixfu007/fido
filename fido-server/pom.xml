<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.3.4</version>
        <relativePath/>
    </parent>

    <groupId>com.fido.server</groupId>
    <artifactId>fido-server</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <name>fido-server</name>
    <description>
        FIDO/FIDO2 驗證伺服器 — 情境 A（標準 WebAuthn，同裝置）。
        骨架版本：persistence 層以 in-memory repository 頂住，待 devops-engineer
        建置 SQL Server 後可替換為 JPA/JDBC 實作（介面於 com.fido.server.repository）。
    </description>

    <properties>
        <java.version>21</java.version>
        <jjwt.version>0.12.6</jjwt.version>
        <bouncycastle.version>1.81</bouncycastle.version>
    </properties>

    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>

        <!-- CBOR 解碼（WebAuthn attestationObject 為 CBOR 格式）；用於解析 fmt/authData/attStmt 頂層結構。 -->
        <dependency>
            <groupId>com.fasterxml.jackson.dataformat</groupId>
            <artifactId>jackson-dataformat-cbor</artifactId>
        </dependency>

        <!--
            Android Key Attestation extension（OID 1.3.6.1.4.1.11129.2.1.17）是一段自訂 ASN.1
            DER 結構（KeyDescription SEQUENCE），JDK 內建 X509Certificate 只能取出其未解碼的
            extnValue 原始 bytes，無法解析內容。bcprov 提供 org.bouncycastle.asn1.* 這組通用
            ASN.1 讀取原語（ASN1Sequence/ASN1Enumerated/ASN1OctetString...），足以完成本專案
            唯一需要的欄位讀取（attestationSecurityLevel / keymasterSecurityLevel /
            attestationChallenge），不需要額外的 CMS/PKIX 協定支援，故正式執行路徑只依賴
            bcprov-jdk18on。X.509 憑證鏈本身的簽章驗證與效期檢查改用 JDK 原生
            java.security.cert API（Certificate#verify / #checkValidity），不假手 BC。
        -->
        <dependency>
            <groupId>org.bouncycastle</groupId>
            <artifactId>bcprov-jdk18on</artifactId>
            <version>${bouncycastle.version}</version>
        </dependency>

        <!-- Session JWT（ES256）簽發與驗證 -->
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-api</artifactId>
            <version>${jjwt.version}</version>
        </dependency>
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-impl</artifactId>
            <version>${jjwt.version}</version>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-jackson</artifactId>
            <version>${jjwt.version}</version>
            <scope>runtime</scope>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>

        <!--
            僅測試需要：組出「合法」的 Android Key Attestation 憑證鏈測試 fixture（含自訂
            attestationSecurityLevel/attestationChallenge extension、簽章鏈）。bcpkix 的
            X509v3CertificateBuilder / ContentSigner 是撰寫這類自簽測試憑證最省力的方式；
            正式執行路徑（main scope）不使用，故限定 test scope，不會被打包進部署產物。
        -->
        <dependency>
            <groupId>org.bouncycastle</groupId>
            <artifactId>bcpkix-jdk18on</artifactId>
            <version>${bouncycastle.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
