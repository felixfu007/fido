<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- 對齊 CLAUDE.md：僅 Android 14+（API 34），故不需相容舊版硬體/CredentialManager 缺失的 fallback。 -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:theme="@style/Theme.FidoCredentialProvider"
        android:networkSecurityConfig="@xml/network_security_config">

        <!--
            核心元件：自訂 CredentialProviderService（對齊 CLAUDE.md「自訂 Android
            CredentialProviderService，掛載於系統 Credential Manager」）。

            - action "android.service.credentials.CredentialProviderService"：系統用來探索本
              APP 是否為可用的憑證提供者。
            - permission "android.permission.BIND_CREDENTIAL_PROVIDER_SERVICE"：Android 14
              強制要求，避免非系統元件任意綁定此 service。
            - <meta-data name="android.credentials.provider">：宣告本 provider 支援的憑證類型
              能力（見 res/xml/provider.xml），系統據此決定是否在 Credential Manager 流程中
              詢問本 provider。
        -->
        <service
            android:name=".FidoCredentialProviderService"
            android:label="@string/app_name"
            android:icon="@mipmap/ic_launcher"
            android:exported="true"
            android:permission="android.permission.BIND_CREDENTIAL_PROVIDER_SERVICE">
            <intent-filter>
                <action android:name="android.service.credentials.CredentialProviderService" />
            </intent-filter>
            <meta-data
                android:name="android.credentials.provider"
                android:resource="@xml/provider" />
        </service>

        <!--
            由 CredentialProviderService 的 CreateEntry / CredentialEntry PendingIntent 呼叫，
            實際執行 Keystore 金鑰產生 / attestationObject 組裝，或 assertion 簽章。
            採用 Dialog 風格主題（見 styles.xml），呈現為系統 Credential Manager ceremony 的
            延續而非獨立 APP 全螢幕接管（對齊清單項目 1 通過判準第 3 點）。
        -->
        <activity
            android:name=".ui.CreatePasskeyActivity"
            android:exported="true"
            android:theme="@style/Theme.FidoCredentialProvider.Dialog"
            android:excludeFromRecents="true" />

        <activity
            android:name=".ui.GetPasskeyActivity"
            android:exported="true"
            android:theme="@style/Theme.FidoCredentialProvider.Dialog"
            android:excludeFromRecents="true" />

        <!--
            【CLAUDE.md「啟動器畫面決策」Option B】prod flavor 唯一帶 MAIN/LAUNCHER 的元件。
            範圍嚴格限定：顯示 provider 啟用狀態、深連結系統憑證提供者設定、版本/客服/隱私文字
            （見 SetupStatusActivity 檔頭完整說明與硬性範圍邊界）。**不得**在此加入任何登入/註冊
            ceremony 或裝置管理 UI——ceremony 一律仍由系統以 PendingIntent 隱式啟動上方
            CreatePasskeyActivity/GetPasskeyActivity。

            本節點放在 src/main（而非 src/prod）：與 FidoCredentialProviderService 等其餘核心元件
            同一慣例，屬於兩個 flavor 共用的正式產品程式碼，非 poc 專屬診斷功能。`poc` flavor 額外
            合併 src/poc/AndroidManifest.xml 的 HarnessActivity 作為第二個 MAIN/LAUNCHER
            （僅診斷建置會出現兩個啟動圖示，`prod` 建置只會有這一個）。
        -->
        <activity
            android:name=".ui.SetupStatusActivity"
            android:label="@string/setup_status_activity_label"
            android:exported="true"
            android:theme="@style/Theme.FidoCredentialProvider">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
            PoC 專用測試 harness（HarnessActivity）**不在**本檔案宣告。它只存在於 `poc` build
            flavor 的 src/poc/AndroidManifest.xml（Gradle manifest merger 會依當下建置的
            flavor 決定要不要併入），`prod` flavor 完全不含這個 activity 節點，也不含對應原始碼
            （見 app/build.gradle.kts productFlavors、harness/HarnessActivity.kt 檔頭說明、
            任務回報「harness 分離」）。

        -->

    </application>
</manifest>
