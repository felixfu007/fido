<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:id="@+id/titleText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="FIDO PoC Harness（模擬購物網站前後端，僅供 PoC，非產品程式碼）"
            android:textStyle="bold"
            android:layout_marginBottom="12dp" />

        <EditText
            android:id="@+id/serverBaseUrlInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="fido-server base URL"
            android:text="http://10.0.2.2:8443" />

        <EditText
            android:id="@+id/apiKeyInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="X-API-Key"
            android:text="dev-api-key-00000000000000000000" />

        <EditText
            android:id="@+id/externalUserIdInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="externalUserId"
            android:text="poc-user-1" />

        <Button
            android:id="@+id/registerButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="1. 註冊新裝置（registration ceremony）" />

        <Button
            android:id="@+id/loginButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="2. 登入（authentication ceremony）" />

        <Button
            android:id="@+id/listDevicesButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="3. 列出已註冊裝置" />

        <Button
            android:id="@+id/expiredChallengeButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="4. 驗證 Challenge 60 秒逾時自動重試" />

        <Button
            android:id="@+id/diagnosticsToggleButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:backgroundTint="#B71C1C"
            android:text="【診斷用，非通過判定】切換：允許軟體金鑰以檢視真實 attestationObject" />

        <TextView
            android:id="@+id/logText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:fontFamily="monospace"
            android:textIsSelectable="true"
            android:text="" />
    </LinearLayout>
</ScrollView>
